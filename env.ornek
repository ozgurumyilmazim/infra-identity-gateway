TZ=Europe/Istanbul

# ==============================================================================
# AĞ VE TRAEFIK GÜVENLİK AYARLARI
# ==============================================================================
# Yerel yönetim ve proxy alt ağı (CIDR formatında)
TRUSTED_SUBNET=172.16.1.0/24

# ==============================================================================
# ALAN ADI VE FQDN TANIMLARI
# ==============================================================================
DOMAIN_INT=sirket.intra
DOMAIN_EXT=sirket.com.tr

# 2. Portainer CE
PORTAINER_INT_FQDN=portainer.sirket.intra
PORTAINER_EXT_FQDN=portainer.sirket.com.tr

# 3. Apache Guacamole
GUACAMOLE_INT_FQDN=guacamole.sirket.intra
GUACAMOLE_EXT_FQDN=guacamole.sirket.com.tr

# 4. pgAdmin 4
PGADMIN_INT_FQDN=pgadmin.sirket.intra
PGADMIN_EXT_FQDN=pgadmin.sirket.com.tr
PGADMIN_DEFAULT_EMAIL=admin@sirket.intra
PGADMIN_DEFAULT_PASSWORD=

# 5. Vaultwarden
VAULTWARDEN_INT_FQDN=vault.sirket.intra
VAULTWARDEN_EXT_FQDN=vault.sirket.com.tr

# 5. Whoami Test Servisi
WHOAMI_INT_FQDN=whoami.sirket.intra
WHOAMI_EXT_FQDN=whoami.sirket.com.tr

# 6. OPNsense Firewall
OPNSENSE_INT_FQDN=opnsense.sirket.intra
OPNSENSE_EXT_FQDN=opnsense.sirket.com.tr
OPNSENSE_INTERNAL_IP=172.16.1.1
OPNSENSE_INTERNAL_PORT=443

# 7. Traefik Dashboard
TRAEFIK_INT_FQDN=traefik.sirket.intra
TRAEFIK_EXT_FQDN=traefik.sirket.com.tr
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=

# 8. SSO (Aka Keycloak)
# UCS Keycloak Apache vhost adı bu FQDN ile aynı olmalıdır (SNI/Host eşleşmesi).
# Harici erişim için UCS üzerinde ilgili SSO FQDN'ini ayarlayın:
#   ucr set keycloak/server/sso/fqdn="sso.<harici-alan-adiniz>"
#   univention-app configure keycloak
SSO_EXT_FQDN=sso.sirket.com.tr
SSO_KEYCLOAK_INT_IP=172.16.1.9
SSO_KEYCLOAK_INT_PORT=443

# CrowdSec Veritabanı
CROWDSEC_DB_USER=crowdsec
CROWDSEC_DB_PASSWORD=
CROWDSEC_DB_NAME=crowdsec_db

# ==============================================================================
# UNIVENTION CORPORATE SERVER (UCS) SAMBA 4 ACTIVE DIRECTORY
# ==============================================================================
UCS_HOST=ucs.sirket.intra
UCS_IP=172.16.1.10
UCS_LDAP_PORT=389
UCS_LDAPS_PORT=636
UCS_BASE_DN=dc=sirket,dc=intra
UCS_USERS_DN=cn=users,dc=sirket,dc=intra
UCS_GROUPS_DN=cn=groups,dc=sirket,dc=intra
UCS_BIND_DN=cn=Administrator,cn=users,dc=sirket,dc=intra
UCS_BIND_PASSWORD=
UCS_WORKGROUP=SIRKET
UCS_REALM=SIRKET.INTRA
UCS_ADMIN_GROUP=Pfsense-Admins

# ==============================================================================
# UCS LDAP CONFIGURATION
# ==============================================================================
UCS_LDAP_SERVER_FQDN=ucs.sirket.intra
UCS_LDAP_PORT=636
UCS_LDAP_BIND_USER=cn=srv-gcml,cn=users,dc=sirket,dc=intra
UCS_LDAP_BIND_PASSWORD=YOUR_UCS_BIND_PASSWORD_HERE
UCS_LDAP_BASE_DN=dc=sirket,dc=intra
UCS_LDAP_USER_DN=cn=users,dc=sirket,dc=intra
UCS_LDAP_GROUP_DN=cn=groups,dc=sirket,dc=intra
UCS_LDAP_SSL=true

# ==============================================================================
# SSL KOK SERTIFIKA
# ==============================================================================
CA_CERT_DIR=/usr/local/share/ca-certificates/*

# ==============================================================================
# MERKEZİ POSTGRESQL (GUACAMOLE, VAULTWARDEN)
# ==============================================================================
# POSTGRES_ADMIN
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Guacamole Veritabanı
GUACAMOLE_DB_USER=guacamole
GUACAMOLE_DB_PASSWORD=
GUACAMOLE_DB_NAME=guacamole_db

# Vaultwarden Veritabanı
VAULTWARDEN_DB_USER=vaultwarden
VAULTWARDEN_DB_PASSWORD=
VAULTWARDEN_DB_NAME=vaultwarden_db

# ==============================================================================
# VAULTWARDEN AYARLARI
# ==============================================================================
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_SIGNUPS_ALLOWED=false
INVITATION_ORG_NAME=vaultwarden
EMERGENCY_ACCESS_ALLOWED=true
# Windows istemcileri icin deneysel bayraklar (virgulle ayrilir, bos = varsayilan)
# Windows Hello SDK IPC: biometrics-sdk-ipc
# Windows autotype: windows-desktop-autotype
EXPERIMENTAL_CLIENT_FEATURE_FLAGS=
# Not: WebAuthn/FIDO2 ve SSO callback'leri DOMAIN'e baglidir. Compose, tek kanonik
# alan adi olarak VAULTWARDEN_EXT_FQDN kullanir; ic agdan da bu FQDN'e split-DNS gerekir.

VAULTWARDEN_SSO_ENABLED=true
VAULTWARDEN_SSO_AUTHORITY=https://sso.sirket.com.tr/realms/ucs
VAULTWARDEN_SSO_CLIENT_ID=vaultwarden
VAULTWARDEN_SSO_CLIENT_SECRET=BURAYA_CLIENT_SECRET
VAULTWARDEN_SSO_SCOPES=openid profile email
VAULTWARDEN_SSO_REDIRECT_URL=https://kasa.sirket.com.tr/identity/connect/oidc-signin


# ==============================================================================
# GÜVENLİK, CERTRESOLVER VE TÜNELLER (CROWDSEC, TAILSCALE, CLOUDFLARE, TLS)
# ==============================================================================
CROWDSEC_BOUNCER_API_KEY=
ACME_EMAIL=admin@sirket.com.tr
CF_DNS_API_TOKEN=
TAILSCALE_AUTH_KEY=<TAILSCALE_AUTH_KEY>
TAILSCALE_ADVERTISED_ROUTES=172.16.1.0/24
CLOUDFLARE_TUNNEL_TOKEN=<CLOUDFLARE_TUNNEL_TOKEN>

# ==============================================================================
# OAUTH2-PROXY
# ==============================================================================
OAUTH2_PROXY_PROVIDER=keycloak-oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://sso.sirket.com.tr/realms/ucs
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=KEYCLOAK_CREDENTIALS_SECRETINIZ
OAUTH2_PROXY_REDIRECT_URL=https://auth.sirket.com.tr/oauth2/callback
OAUTH2_PROXY_UPSTREAMS=static://202
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_COOKIE_SECRET=URETTIGINIZ_BASE64_SECRET
OAUTH2_PROXY_COOKIE_DOMAINS=.sirket.com.tr
OAUTH2_PROXY_WHITELIST_DOMAINS=.sirket.com.tr
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_OIDC_END_SESSION_URL=https://sso.sirket.com.tr/realms/ucs/protocol/openid-connect/logout

# ==============================================================================
# GUACAMOLE OIDC AYARLARI
# ==============================================================================
GUACAMOLE_OPENID_AUTHORIZATION_ENDPOINT="https://sso.sirket.com.tr/realms/ucs/protocol/openid-connect/auth"
GUACAMOLE_OPENID_JWKS_ENDPOINT="https://sso.sirket.com.tr/realms/ucs/protocol/openid-connect/certs"
GUACAMOLE_OPENID_ISSUER="https://sso.sirket.com.tr/realms/ucs"
GUACAMOLE_OPENID_CLIENT_ID="guacamole"
GUACAMOLE_OPENID_REDIRECT_URI="https://guacamole.sirket.com.tr/"
GUACAMOLE_OPENID_USERNAME_CLAIM_TYPE="preferred_username"
GUACAMOLE_OPENID_SCOPES="openid email profile"

GUACAMOLE_LDAP_HOSTNAME= "ana.sirket.intra"
GUACAMOLE_LDAP_PORT= 636
GUACAMOLE_LDAP_ENCRYPTION_METHOD= "ssl"
# (Opsiyonel ama yararlı) LDAPS bağlantısında sunucu kimliğini tam doğrulaması için
GUACAMOLE_LDAP_SSL_PROTOCOL= "TLSv1.2"

# Kullanıcıların aranacağı ana dizin
GUACAMOLE_LDAP_USER_BASE_DN= "cn=users,dc=sirket,dc=intra"

# Windows/Samba uyumlu kullanıcı adı niteliği
GUACAMOLE_LDAP_USERNAME_ATTRIBUTE= "sAMAccountName"

# UCS'de oluşturduğunuz sorgulama kullanıcısı
GUACAMOLE_LDAP_SEARCH_BIND_DN= "cn=srv-guacamole,cn=users,dc=sirket,dc=intra"
GUACAMOLE_LDAP_SEARCH_BIND_PASSWORD= "guvenliBirSifre!123"

# Grupların aranacağı dizin (Opsiyonel ama önerilir)
GUACAMOLE_LDAP_GROUP_BASE_DN= "cn=groups,dc=sirket,dc=intra"
GUACAMOLE_LDAP_GROUP_NAME_ATTRIBUTE= "cn"
