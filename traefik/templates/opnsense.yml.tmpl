http:
  routers:
    opnsense-int:
      rule: "Host(`${OPNSENSE_INT_FQDN}`)"
      entryPoints:
        - "websecure"
      service: "opnsense-service"
      tls: {}

    opnsense-ext:
      rule: "Host(`${OPNSENSE_EXT_FQDN}`)"
      entryPoints:
        - "webexternalunsecure"
      middlewares:
        - "crowdsec@file"
      service: "opnsense-service"

  services:
    opnsense-service:
      loadBalancer:
        serversTransport: "unSecureTransport"
        servers:
          - url: "https://${OPNSENSE_INTERNAL_IP}:${OPNSENSE_INTERNAL_PORT}"
        passHostHeader: true