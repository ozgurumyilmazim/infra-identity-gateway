tls:
  certificates:
    # İç ağ (.intra) erişimleri için UCS Root CA tarafından imzalanmış sertifika
    - certFile: /certs/ucs/ucs-int.crt
      keyFile: /certs/ucs/ucs-int.key
      stores:
        - default
    #- certFile: /certs/ucs/traefik.icat.intra.crt
    #  keyFile: /certs/ucs/traefik.icat.intra.key
    #  stores:
    #    - default
    # Mevcut genel sertifika (harici/diğer kullanım için yedek)
    #- certFile: /certs/ucs-cert.crt
    #  keyFile: /certs/ucs-cert.key
    #  stores:
    #    - default

  options:
    default::
      minVersion: VersionTLS12
      sniStrict: false

http:
  serversTransports:
    unSecureTransport:
      insecureSkipVerify: true
      
    ucsInternalTransport:
      rootCAs:
        - /certs/ucs/ucs-root-ca.crt
      insecureSkipVerify: false